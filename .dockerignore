# Игнорируем файлы Git
.git
.gitignore

# Игнорируем логи и временные файлы
log/*
tmp/*
*.log

# Игнорируем файлы разработки
.env*
!.env.example

# Игнорируем node_modules если есть
node_modules

# Игнорируем файлы IDE
.vscode
.idea

# Игнорируем файлы операционной системы
.DS_Store
Thumbs.db

# Игнорируем файлы тестов
test/
spec/
coverage/

# Игнорируем документацию (кроме README.md)
# README.md теперь включается в образ для эндпоинта /readme
*.md
!README.md

# Игнорируем файлы базы данных разработки
*.sqlite3
*.db
development.sqlite3

# Игнорируем storage
storage/*